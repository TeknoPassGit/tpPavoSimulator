<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <PublishIISAssets>false</PublishIISAssets>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <RestoreSources></RestoreSources>
    <DefaultItemExcludes>$(DefaultItemExcludes);Release/**;Verification/**;runtime/**;tests/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**;Templates\**;References\**;wwwroot\**;global.json;NuGet.Config" />
    <EmbeddedResource Include="Templates\*.json;wwwroot\**\*" />
    <None Update="References\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>